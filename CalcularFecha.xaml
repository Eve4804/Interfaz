<Window x:Class="Interfaz.CalcularFecha"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calcular Fecha de Entrega"
        Width="700"
        Height="428"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" HorizontalAlignment="Center">
        <TextBlock Text="Calcular Fecha de Entrega" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="#333" 
                   Margin="0,0,0,20"/>

        <Border Background="#F0F0F0" CornerRadius="10" Padding="15">
            <StackPanel>
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Campos alineados -->
                    <TextBlock Text="ID Pedido" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Width="250" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="ID Cliente" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Width="250" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Cliente que lo solicita" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Width="250" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Producto o servicio" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Width="250" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Cantidad" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Width="250" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Total a pagar" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Width="250" Height="35" VerticalContentAlignment="Center" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Disponibilidad" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <ComboBox Grid.Row="6" Grid.Column="1" Width="250" Height="35" Background="#F9F9F9" BorderBrush="#CCC" Padding="5">
                        <ComboBoxItem Content="En inventario"/>
                        <ComboBoxItem Content="Contactar proveedor"/>
                    </ComboBox>

                    <!-- Botones -->
                    <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10,10,10,0">
                        <Button Content="Notificar a proveedor" Width="130" Background="#FF9800" Foreground="White" BorderBrush="#FF9800" Height="21"/>
                        <Button Content="Enviar pedido" Width="180" Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50" Margin="0,0,10,0"/>
                        <Button Content="Ir a menú" Width="180" Background="#6CA0DC" Foreground="White" BorderBrush="#D0E6F6"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>

