<Window x:Class="Interfaz.GestionVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Ventas"
        Width="1100"
        Height="750"
        Background="{StaticResource FondoAzulGradiente}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TextBlock Text="💰 Gestión de Ventas" 
                   Style="{StaticResource TituloVentana}"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"/>

        <Border Style="{StaticResource ContenedorBlanco}" 
                Margin="40,80,40,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

               
                <!-- Barra de búsqueda -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBox x:Name="TxtBuscar" 
             Width="300" Height="35" 
             Background="#F9F9F9" BorderBrush="#DDD"
             VerticalContentAlignment="Center" Padding="10,0"
             FontSize="14"/>
                    <Button Content="🔍 Buscar" Width="100" Height="35"
            Background="#2196F3" Foreground="White" 
            BorderThickness="0" Margin="310,0,0,0"
            Click="BtnBuscar_Click"
            Cursor="Hand"/>
                </Grid>
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                        <!-- Botón Excel -->
                        <Button Content="Exportar a Excel"
                Width="140" Height="40" Margin="5"
                Background="#A8E6CF" Foreground="Black"
                FontWeight="Bold" Padding="10"
                Click="ExportarExcel_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Botón PDF -->
                        <Button Content="Exportar a PDF"
                Width="140" Height="40" Margin="5"
                Background="#FFB6B6" Foreground="Black"
                FontWeight="Bold" Padding="10"
                Click="ExportarPDF_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10"
                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
                <!-- Pestañas -->
                <TabControl x:Name="TabControlVentas" Grid.Row="2" BorderThickness="0">
                    <!-- Pedidos Nuevos -->
                    <TabItem Header="📋 Pedidos Nuevos" FontSize="14" Padding="15,10">
                        <Grid>
                            <DataGrid x:Name="DgPedidosNuevos"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="0"
                                      SelectionChanged="DgPedidosNuevos_SelectionChanged"
                                      Margin="10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdVenta}" Width="70"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="140"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="140"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="180"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Método Pago" Binding="{Binding MetodoPago}" Width="110"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✓ Confirmar" 
                                                            Background="#4CAF50" Foreground="White"
                                                            BorderThickness="0" Padding="8,4" Margin="2"
                                                            Click="BtnConfirmar_Click"
                                                            Cursor="Hand"/>
                                                    <Button Content="✗ Cancelar" 
                                                            Background="#F44336" Foreground="White"
                                                            BorderThickness="0" Padding="8,4" Margin="2"
                                                            Click="BtnCancelar_Click"
                                                            Cursor="Hand"/>
                                                    <Button Content="👁️ Detalles"
                                                            Background="#2196F3" Foreground="White"
                                                            BorderThickness="0" Padding="8,4" Margin="2"
                                                            Click="BtnVerDetalles_Click"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Pedidos Pendientes -->
                    <TabItem Header="⏳ Pedidos Pendientes" FontSize="14" Padding="15,10">
                        <Grid>
                            <DataGrid x:Name="DgPedidosPendientes"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="0"
                                      SelectionChanged="DgPedidosPendientes_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdVenta}" Width="70"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="150"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="150"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="180"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="90"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="100"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="👁️ Ver Detalles" 
                                                        Background="#2196F3" Foreground="White"
                                                        BorderThickness="0" Padding="8,4" Margin="2"
                                                        Click="BtnVerDetalles_Click"
                                                        Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Pedidos Cancelados -->
                    <TabItem Header="❌ Pedidos Cancelados" FontSize="14" Padding="15,10">
                        <Grid>
                            <DataGrid x:Name="DgPedidosCancelados"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdVenta}" Width="70"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="100"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="150"/>
                                    <DataGridTextColumn Header="Producto" Binding="{Binding ProductoNombre}" Width="150"/>
                                    <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="80"/>
                                    <DataGridTextColumn Header="Dirección" Binding="{Binding Direccion}" Width="180"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="90"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="👁️ Ver Detalles"
                                                        Background="#666" Foreground="White"
                                                        BorderThickness="0" Padding="8,4"
                                                        Click="BtnVerDetalles_Click"
                                                        Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <!-- Botón Cerrar -->
                <Button Grid.Row="3"
                        Content="Cerrar" Width="120" Height="40"
                        Background="#666" Foreground="White"
                        BorderThickness="0" HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Click="BtnCerrar_Click"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
