<Window x:Class="Interfaz.GestionVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Ventas"
        Width="1100"
        Height="750"
        Background="{StaticResource FondoAzulGradiente}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TextBlock Text="💰 Gestión de Ventas" 
                   Style="{StaticResource TituloVentana}"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"/>

        <Border Style="{StaticResource ContenedorBlanco}" 
                Margin="40,80,40,40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtBuscar" 
                                 Width="300" 
                                 Height="35" 
                                 Background="#F9F9F9" 
                                 BorderBrush="#DDD"
                                 VerticalContentAlignment="Center"
                                 Padding="10,0"
                                 FontSize="14"/>
                        <Button Content="🔍 Buscar" 
                                Width="100" 
                                Height="35" 
                                Background="#2196F3" 
                                Foreground="White" 
                                BorderThickness="0"
                                Margin="10,0,0,0" 
                                Click="BtnBuscar_Click"
                                Cursor="Hand"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="➕ Nueva Venta" 
                            Width="150" 
                            Height="35" 
                            Background="#4CAF50" 
                            Foreground="White" 
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="BtnNuevaVenta_Click"
                            Cursor="Hand"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#E3F2FD" CornerRadius="5" Padding="15" Margin="0,0,5,0">
                        <StackPanel>
                            <TextBlock Text="Pedidos Nuevos" FontSize="12" Foreground="#666"/>
                            <TextBlock x:Name="TxtTotalNuevos" Text="0" FontSize="24" FontWeight="Bold" Foreground="#2196F3"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="#FFF3E0" CornerRadius="5" Padding="15" Margin="5,0">
                        <StackPanel>
                            <TextBlock Text="Pedidos Pendientes" FontSize="12" Foreground="#666"/>
                            <TextBlock x:Name="TxtTotalPendientes" Text="0" FontSize="24" FontWeight="Bold" Foreground="#FF9800"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="#FFEBEE" CornerRadius="5" Padding="15" Margin="5,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Pedidos Cancelados" FontSize="12" Foreground="#666"/>
                            <TextBlock x:Name="TxtTotalCancelados" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F44336"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <TabControl Grid.Row="2" BorderThickness="0">
                    <TabItem Header="📋 Pedidos Nuevos" FontSize="14" Padding="15,10">
                        <Grid>
                            <DataGrid x:Name="DgPedidosNuevos"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="0"
                                      SelectionChanged="DgPedidosNuevos_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdVenta}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120"/>
                                    <DataGridTextColumn Header="Método Pago" Binding="{Binding MetodoPago}" Width="130"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="✓ Confirmar" 
                                                            Background="#4CAF50" 
                                                            Foreground="White" 
                                                            BorderThickness="0"
                                                            Padding="8,4"
                                                            Margin="2"
                                                            Click="BtnConfirmar_Click"
                                                            Cursor="Hand"/>
                                                    <Button Content="✗ Cancelar" 
                                                            Background="#F44336" 
                                                            Foreground="White" 
                                                            BorderThickness="0"
                                                            Padding="8,4"
                                                            Margin="2"
                                                            Click="BtnCancelar_Click"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="⏳ Pedidos Pendientes" FontSize="14" Padding="15,10">
                        <Grid>
                            <DataGrid x:Name="DgPedidosPendientes"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="0"
                                      SelectionChanged="DgPedidosPendientes_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdVenta}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120"/>
                                    <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="130"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="👁️ Ver Detalles" 
                                                            Background="#2196F3" 
                                                            Foreground="White" 
                                                            BorderThickness="0"
                                                            Padding="8,4"
                                                            Margin="2"
                                                            Click="BtnVerDetalles_Click"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="❌ Pedidos Cancelados" FontSize="14" Padding="15,10">
                        <Grid>
                            <DataGrid x:Name="DgPedidosCancelados"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      GridLinesVisibility="None"
                                      HeadersVisibility="Column"
                                      Background="White"
                                      RowBackground="White"
                                      AlternatingRowBackground="#F9F9F9"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID Pedido" Binding="{Binding IdVenta}" Width="100"/>
                                    <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="120"/>
                                    <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNombre}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="120"/>
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Notas}" Width="200"/>
                                    <DataGridTemplateColumn Header="Acciones" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="👁️ Ver Detalles" 
                                                        Background="#666" 
                                                        Foreground="White" 
                                                        BorderThickness="0"
                                                        Padding="8,4"
                                                        Click="BtnVerDetalles_Click"
                                                        Cursor="Hand"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Button Grid.Row="3"
                        Content="Cerrar" 
                        Width="120" 
                        Height="40" 
                        Background="#666" 
                        Foreground="White" 
                        BorderThickness="0"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        Click="BtnCerrar_Click"
                        Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>