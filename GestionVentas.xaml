<Window x:Class="Interfaz.GestionVentas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Ventas"
        Width="800"
        Height="750"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <ScrollViewer>
        <StackPanel Margin="20" HorizontalAlignment="Center">
            <!-- Buscador -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,25">
                <TextBox Width="300" Height="30" Background="#F9F9F9" BorderBrush="#CCC"/>
                <Button Content="Buscar" Width="100" Height="30" Background="#6CA0DC" Foreground="White" BorderBrush="#4A7EBB" Margin="10,0,0,0"/>
            </StackPanel>

            <!-- Pedidos Nuevos -->
            <Border Background="#F0F0F0" CornerRadius="10" Padding="15" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Pedidos Nuevos" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ID Pedido" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="ID Cliente" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Cliente que lo solicita" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Producto o servicio" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Cantidad" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Total a pagar" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <Button Content="Calcular fecha de entrega" Grid.Row="6" Grid.ColumnSpan="2" Width="200" Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Pedidos Cancelados -->
            <Border Background="#F0F0F0" CornerRadius="10" Padding="15" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Pedidos Realizados" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ID Pedido" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="ID Cliente" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Nombre del cliente" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Producto o servicio" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Cantidad" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Total a pagar" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- Pedidos Realizados -->
            <Border Background="#F0F0F0" CornerRadius="10" Padding="15" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Pedidos Realizados" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="ID Pedido" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="ID Cliente" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Nombre del cliente" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Producto o servicio" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Cantidad" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Total a pagar" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Fecha de Entrega" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC"/>

                        <TextBlock Text="Estado de la orden" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                        <ComboBox Grid.Row="7" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC">
                            <ComboBoxItem Content="Pendiente"/>
                            <ComboBoxItem Content="En proceso"/>
                            <ComboBoxItem Content="Completada"/>
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Botón final -->
            <Button Content="Ir a Menú" Width="200" Height="40"
                    Background="#6CA0DC" Foreground="White" 
                    BorderBrush="#4A7EBB" HorizontalAlignment="Center" Margin="0,10,0,20"/>
        </StackPanel>
    </ScrollViewer>
</Window>

