<Window x:Class="Interfaz.ContactarProv"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Contactar a proveedores"
        Width="800"
        Height="550"
        Background="{StaticResource FondoAzulGradiente}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <!-- Título superior -->
        <TextBlock Text="📨 Contactar a proveedores"
                   Style="{StaticResource TituloVentana}"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"/>

        <!-- Contenedor principal -->
        <Border Style="{StaticResource ContenedorBlanco}" Margin="40,80,40,40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" HorizontalAlignment="Center">

                    <!-- Título interno -->
                    <TextBlock Text="Formulario de solicitud"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#333"
                               Margin="0,0,0,20"/>

                    <!-- Botón notificaciones -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
                        <Button Width="40" Height="40"
                                ToolTip="Ver notificaciones"
                                Background="#F9F9F9"
                                BorderBrush="#CCC"
                                Click="Notificaciones_Click">
                            <TextBlock FontSize="20" Text="🔔" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Button>
                    </StackPanel>

                    <!-- Formulario -->
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="250"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Tipo de proveedor -->
                        <TextBlock Text="Tipo de proveedor" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#555" Margin="0,5"/>
                        <ComboBox x:Name="cmbProveedor" Grid.Row="0" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC" Margin="0,5">
                            <ComboBoxItem Content="Cartón"/>
                            <ComboBoxItem Content="Plásticos"/>
                            <ComboBoxItem Content="Vehículos"/>
                        </ComboBox>

                        <!-- Id Solicitud -->
                        <TextBlock Text="Id Solicitud" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#555" Margin="0,5"/>
                        <TextBox x:Name="txtId" Grid.Row="1" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC" Margin="0,5"/>

                        <!-- Id Producto -->
                        <TextBlock Text="Id Producto" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#555" Margin="0,5"/>
                        <TextBox x:Name="txtProducto" Grid.Row="2" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC" Margin="0,5"/>

                        <!-- Nombre del producto/servicio -->
                        <TextBlock Text="Nombre del producto/servicio" Grid.Row="3" Grid.Column="0" VerticalAlignment="Top" Foreground="#555" Margin="0,5"/>
                        <TextBox x:Name="txtDescripcion" Grid.Row="3" Grid.Column="1" Width="250" Height="60"
                                 Background="#F9F9F9" BorderBrush="#CCC" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,5"/>

                        <!-- Cantidad solicitada -->
                        <TextBlock Text="Cantidad solicitada" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#555" Margin="0,5"/>
                        <TextBox x:Name="txtCantidad" Grid.Row="4" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC" Margin="0,5"/>

                        <!-- Fecha -->
                        <TextBlock Text="Fecha en que se solicita" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="#555" Margin="0,5"/>
                        <DatePicker x:Name="dpFecha" Grid.Row="5" Grid.Column="1" Width="250" Background="#F9F9F9" BorderBrush="#CCC" Margin="0,5" SelectedDateFormat="Short"/>
                    </Grid>

                    <!-- Botones -->
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <Button Content="Enviar solicitud"
                                    Width="150"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderBrush="#4CAF50"
                                    Margin="0,0,15,0"
                                    Click="EnvSolicitud_Click"/>
                            <Button Content="Ir a app"
                                    Width="150"
                                    Background="#D5E8D4"
                                    Foreground="#333"
                                    BorderBrush="#526685"
                                    Click="IrApp_Click"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Cancelar"
                                    Width="150"
                                    Background="#F44336"
                                    Foreground="White"
                                    BorderBrush="#F44336"
                                    Margin="0,0,15,0"
                                    Click="Cancelar_Click"/>
                            <Button Content="Ir a Menú"
                                    Width="150"
                                    Background="#6CA0DC"
                                    Foreground="White"
                                    BorderBrush="#4A7EBB"
                                    Click="IrMenu_Click"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>