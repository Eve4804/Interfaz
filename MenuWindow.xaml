<Window x:Class="Interfaz.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sistema ERP - Menú Principal"
        Width="1200"
        Height="700"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Barra superior -->
        <Border Grid.Row="0" Background="#2196F3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Título y usuario -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="📊 Sistema ERP" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtUsuario" 
                               Text="Usuario: Admin" 
                               FontSize="14" 
                               Foreground="White" 
                               VerticalAlignment="Center" 
                               Margin="30,0,0,0"/>
                </StackPanel>

                <!-- Botones de acción -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <Button Content="🔔 Notificaciones" 
                            Background="Transparent" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,0" 
                            Cursor="Hand"
                            Click="BtnNotificaciones_Click"/>
                    <Button Content="⚙️ Configuración" 
                            Background="Transparent" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,0" 
                            Cursor="Hand"
                            Margin="10,0,0,0"/>
                    <Button Content="🚪 Cerrar Sesión" 
                            Background="#F44336" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="15,10" 
                            Cursor="Hand"
                            Margin="10,0,0,0"
                            Click="BtnCerrarSesion_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="40">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sección: Ventas y Clientes -->
                <StackPanel Grid.Row="0" Margin="0,0,0,30">
                    <TextBlock Text="📈 Ventas y Clientes" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#333" 
                               Margin="0,0,0,15"/>
                    
                    <WrapPanel>
                        <!-- Gestión de Ventas -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnGestionVentas_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💰" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Gestión de Ventas" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Crear y administrar ventas" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Historial de Ventas -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnHistorialVentas_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📊" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Historial de Ventas" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Consultar ventas realizadas" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Gestión de Clientes -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnClientes_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="👥" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Gestión de Clientes" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Administrar clientes" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Sección: Inventario y Productos -->
                <StackPanel Grid.Row="1" Margin="0,0,0,30">
                    <TextBlock Text="📦 Inventario y Productos" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#333" 
                               Margin="0,0,0,15"/>
                    
                    <WrapPanel>
                        <!-- Inventarios -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnInventarios_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Inventarios" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Control de stock" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Catálogo de Productos -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnCatalogo_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📋" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Catálogo de Productos" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Gestionar productos" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Calcular Fecha de Entrega -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnCalcularFecha_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📅" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Calcular Entrega" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Fechas de entrega" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>

                <!-- Sección: Proveedores y Pagos -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="🏢 Proveedores y Pagos" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="#333" 
                               Margin="0,0,0,15"/>
                    
                    <WrapPanel>
                        <!-- Contactar Proveedores -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnContactarProveedor_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📞" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Contactar Proveedores" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Solicitudes a proveedores" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Gestión de Pagos -->
                        <Border Background="White" 
                                CornerRadius="10" 
                                Padding="20" 
                                Margin="0,0,15,15" 
                                Width="250" 
                                Height="150"
                                Cursor="Hand"
                                MouseLeftButtonDown="BtnPagos_Click">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💳" FontSize="40" Margin="0,0,0,10"/>
                                <TextBlock Text="Gestión de Pagos" FontSize="16" FontWeight="Bold" Foreground="#333"/>
                                <TextBlock Text="Pagos a proveedores" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Barra inferior -->
        <Border Grid.Row="2" Background="#333">
            <TextBlock Text="Sistema ERP v1.0.0 | © 2025 Todos los derechos reservados" 
                       Foreground="White" 
                       FontSize="10" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
