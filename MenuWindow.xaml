<Window x:Class="Interfaz.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Menú Principal"
        Width="400"
        Height="501"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" HorizontalAlignment="Center">
        <!-- Título -->
        <TextBlock Text="Menú Principal" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Foreground="#333" 
                   Margin="0,0,0,20"/>

        <!-- Panel gris que contiene los botones -->
        <Border Background="#F0F0F0" Padding="15" CornerRadius="10">
            <StackPanel HorizontalAlignment="Center">
                <Button Content="Catálogo de productos" Width="220" Height="40" Background="#C8B89E" Foreground="White" BorderBrush="#000000" Margin="0,0,0,10" Click="CatProd_Click"/>
                <Button Content="Clientes" Width="220" Height="40" Background="#D5E8D4" Foreground="#333" BorderBrush="#000000" Margin="0,0,0,10" Click="Clientes_Clic"/>
                <Button Content="Historial de ventas" Width="220" Height="40" Background="#D0E6F6" Foreground="#333" BorderBrush="#000000" Margin="0,0,0,10" Click="HistorVtn_Click"/>
                <Button Content="Pagos" Width="220" Height="40" Background="#E6E6FA" Foreground="#333" BorderBrush="#000000" Margin="0,0,0,10" Click="Pagos_Click"/>
                <Button Content="Inventarios" Width="220" Height="40" Background="#FFFACD" Foreground="#333" BorderBrush="#000000" Margin="0,0,0,10" Click="Inventarios"/>
                <Button Content="Gestión de ventas" Width="220" Height="40" Background="#FADADD" Foreground="#333" BorderBrush="#000000" Margin="0,0,0,10" Click="GestiVenta_Click"/>
                <Button Content="Cerrar sesión" Width="220" Height="40" Background="#a95858" Foreground="White" BorderBrush="#000000" Click="CerrarSe_Click"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
