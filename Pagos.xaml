<Window x:Class="Interfaz.Pagos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Pagos"
        Width="1050"
        Height="580"
        WindowStartupLocation="CenterScreen">

    <!-- Fondo con gradiente moderno -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#E3F2FD" Offset="0"/>
            <GradientStop Color="#BBDEFB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <!-- Recursos -->
    <Window.Resources>

        <!-- Estilo de botón con icono -->
        <Style x:Key="BotonPago" TargetType="Button">
            <Setter Property="Height" Value="45"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#F0F3F4"/>
            <Setter Property="Foreground" Value="#333"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10 0 0 0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="5"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1">

                            <StackPanel Orientation="Horizontal">
                                <Path Width="22" Height="22"
                                      Fill="#333"
                                      Margin="0 0 12 0"
                                      Data="{TemplateBinding Tag}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ICONOS MATERIAL DESIGN -->
        <Geometry x:Key="IconHistorial">
            M12,20A8,8 0 1,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M11,6H13V13H11V6M11,14H13V16H11V14Z
        </Geometry>

        <Geometry x:Key="IconGuardar">M17 3H7a2 2 0 00-2 2v14l7-3 
            7 3V5a2 2 0 00-2-2z</Geometry>

        <Geometry x:Key="IconCancelar">M12 2C6.48 2 2 6.48 2 12s4.48 10 
            10 10 10-4.48 10-10S17.52 2 12 2zm5 13.59L15.59 17 12 13.41 
            8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 
            8.41 13.41 12 17 15.59z</Geometry>

    </Window.Resources>

    <Grid Margin="20">

        <Border Background="White"
                CornerRadius="15"
                Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15"
                                  ShadowDepth="3" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Título moderno -->
                <TextBlock Text="Registro de Pagos"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#1A237E"
                           HorizontalAlignment="Center"
                           Margin="0 0 0 25"/>

                <!-- FORMULARIO -->
                <Grid Grid.Row="1" Margin="0 10 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260"/>
                        <!-- Ampliado para que no corte texto -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Labels -->
                    <StackPanel Grid.Column="0" Margin="10">
                        <TextBlock Text="Forma de Pago:" Margin="0 10"/>
                        <TextBlock Text="ID Solicitud:" Margin="0 9"/>
                        <TextBlock Text="Proveedor:" Margin="0 15"/>
                        <TextBlock Text="Monto Total:" Margin="0 2"/>

                        <!-- NUEVO -->
                        <TextBlock Text="Número de Cuenta:" Margin="0 10"/>

                        <TextBlock Text="Clabe Interbancaria:" Margin="0 5"/>
                        <TextBlock Text="Fecha de Pago:" Margin="0 11"/>
                    </StackPanel>

                    <!-- Inputs -->
                    <StackPanel Grid.Column="1" Margin="1">
                        <TextBox Text="Transferencia" IsReadOnly="True" Margin="0 8"/>
                        <TextBox x:Name="txtSolicitud" LostFocus="txtSolicitud_LostFocus" Margin="0 15" />
                        <TextBox x:Name="txtProveedor" IsReadOnly="True" Background="#F0F0F0" />
                        <TextBox x:Name="txtMonto" IsReadOnly="True" Background="#F0F0F0" Margin="0 6"/>

                        <!-- NUEVO -->
                        <TextBox x:Name="txtNumeroCuenta" Margin="0 6" MaxLength="16"/>

                        <TextBox x:Name="txtClabe" Margin="0 6" MaxLength="18"/>

                        <DatePicker x:Name="dtpFechaPago" Margin="0 6"/>
                    </StackPanel>
                </Grid>

                <!-- BOTONES -->
                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0 25 0 0">

                    <!-- Guardar -->
                    <Button Content="Guardar Pago"
                            Style="{StaticResource BotonPago}"
                            Tag="{StaticResource IconGuardar}"
                            Background="#C8E6C9"
                            Click="BtnGuardar_Click"/>

                    <Button Content="Historial de Pagos"
                            Style="{StaticResource BotonPago}"
                            Tag="{StaticResource IconHistorial}"
                            Width="180"
                            Height="40"
                            Background="#BBDEFB"
                            Click="BtnHistorialPagos_Click"/>

                    <!-- Cancelar Pago -->
                    <Button Content="Cancelar Pago"
                            Style="{StaticResource BotonPago}"
                            Background="#FFCDD2"
                            Tag="{StaticResource IconCancelar}"
                            Click="BtnCancelar_Click"/>

                </StackPanel>

            </Grid>
        </Border>

    </Grid>

</Window>