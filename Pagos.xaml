<Window x:Class="Interfaz.Pagos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Pagos"
        Width="700"
        Height="500"
        Background="White"
        WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20" HorizontalAlignment="Center">
        <TextBlock Text="Registro de Pagos"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="#333"
                   Margin="0,0,0,20"/>

        <Border Background="#F0F0F0" CornerRadius="10" Padding="15">
            <StackPanel>
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Campos de pago -->
                    <TextBlock Text="ID Proveedor:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Height="30" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="ID Solicitud:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Height="30" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Monto Total:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Height="30" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Forma de Pago:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <ComboBox Grid.Row="3" Grid.Column="1" Height="30" Background="#F9F9F9" BorderBrush="#CCC">
                        <ComboBoxItem Content="Transferencia"/>
                        <ComboBoxItem Content="Efectivo"/>
                        <ComboBoxItem Content="Cheque"/>
                        <ComboBoxItem Content="Tarjeta"/>
                    </ComboBox>

                    <TextBlock Text="Fecha de Pago:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <DatePicker Grid.Row="4" Grid.Column="1" Height="30" Background="#F9F9F9" BorderBrush="#CCC"/>

                    <TextBlock Text="Estado del Pago:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Foreground="#555"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" Height="30" Background="#F9F9F9" BorderBrush="#CCC">
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="Pagado"/>
                        <ComboBoxItem Content="Cancelado"/>
                    </ComboBox>
                </Grid>

                <!-- Botones -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,30,0,0">
                    <Button Content="Guardar" Width="120" Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50" Margin="10"/>
                    <Button Content="Cancelar" Width="120" Background="#F44336" Foreground="White" BorderBrush="#F44336" Margin="10"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>