<Window x:Class="Interfaz.Pagos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registro de Pagos" Width="600" Height="450"
        WindowStartupLocation="CenterScreen"
        Background="#F4F4F4">

    <Border CornerRadius="12" Background="White" Padding="20" Margin="20" >
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <!-- Título -->
            <TextBlock Text="Registro de Pagos"
           FontSize="26"
           FontWeight="Bold"
           HorizontalAlignment="Center"
           Margin="0 0 0 20"
           Background="LightBlue"
           Padding="8"/>


            <!-- Contenedor principal -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="10">
                    <TextBlock Text="ID Proveedor:"  Margin="0 5"/>
                    <TextBlock Text="ID Solicitud:"  Margin="0 5"/>
                    <TextBlock Text="Monto Total:"   Margin="0 5"/>
                    <TextBlock Text="Forma de Pago:" Margin="0 12"/>
                    <TextBlock Text="Fecha de Pago:" Margin="0 7"/>
                    <TextBlock Text="Estado del Pago:" Margin="0 4"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="10">
                    <TextBox x:Name="txtProveedor" Margin="0 5"/>
                    <TextBox x:Name="txtSolicitud" Margin="0 5"/>
                    <TextBox x:Name="txtMonto" Margin="0 5"/>

                    <ComboBox x:Name="cmbFormaPago" Margin="0 5">
                        <ComboBoxItem Content="Transferencia"/>
                        <ComboBoxItem Content="Tarjeta"/>
                        <ComboBoxItem Content="Depósito"/>
                    </ComboBox>

                    <DatePicker x:Name="dtpFechaPago" Margin="0 5"/>

                    <ComboBox x:Name="cmbEstadoPago" Margin="0 5">
                        <ComboBoxItem Content="Pendiente"/>
                        <ComboBoxItem Content="Pagado"/>
                        <ComboBoxItem Content="Cancelado"/>
                    </ComboBox>
                </StackPanel>
            </Grid>

            <!-- Botones -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                <Button Content="Guardar" Width="120" Height="35" Background="#FF1E90FF" Foreground="White" Margin="10"
                        Click="BtnGuardar_Click"/>
                <Button Content="Cancelar" Width="120" Height="35" Background="#E53935" Foreground="White" Margin="10"
                        Click="BtnCancelar_Click"/>
            </StackPanel>

        </Grid>
    </Border>
</Window>
