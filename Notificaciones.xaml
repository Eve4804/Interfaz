<Window x:Class="Interfaz.Notificaciones"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notificaciones" Height="450" Width="800"
        Background="White" WindowStartupLocation="CenterScreen">

    <StackPanel Margin="20">
        <!-- Título -->
        <TextBlock Text="Notificaciones"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#333"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Pestañas -->
        <TabControl>
            <!-- Solicitudes enviadas -->
            <TabItem Header="Solicitudes enviadas">
                <ListBox x:Name="lstSolicitudes"
                         Height="250"
                         SelectionChanged="lstSolicitudes_SelectionChanged"/>
            </TabItem>

            <!-- Respuestas recibidas -->
            <TabItem Header="Respuestas recibidas">
                <ListBox x:Name="lstRespuestas"
                         Height="250"
                         SelectionChanged="lstRespuestas_SelectionChanged"/>
            </TabItem>
        </TabControl>

        <!-- Botón cerrar -->
        <Button Content="Cerrar"
                Width="120"
                Height="35"
                Background="#F44336"
                Foreground="White"
                BorderBrush="#F44336"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Click="Cerrar_Click"/>
    </StackPanel>
</Window>