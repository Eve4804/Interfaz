<Window x:Class="Interfaz.Catalogo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Catálogo de Productos"
        Width="1000"
        Height="700"
        Background="{StaticResource FondoAzulGradiente}"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <TextBlock Text="📦 Catálogo de Productos" 
                   Style="{StaticResource TituloVentana}"
                   Margin="0,20,0,0"
                   VerticalAlignment="Top"/>

        <Border Style="{StaticResource ContenedorBlanco}" 
                Margin="40,80,40,40">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">

                    <!-- TÍTULO -->
                    <TextBlock Text="Catálogo de Productos"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Foreground="#333"
                               Margin="0,0,0,20"/>

                    <Border Background="#F0F0F0" CornerRadius="10" Padding="15">
                        <StackPanel>

                            <!-- BUSCAR PRODUCTO -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                <TextBlock Text="Buscar producto:"
                                           VerticalAlignment="Center"
                                           Foreground="#555"
                                           Margin="0,0,10,0"/>

                                <TextBox x:Name="TxtBuscar"
                                         Width="300"
                                         Height="30"
                                         Background="#F9F9F9"
                                         BorderBrush="#CCC"
                                         KeyDown="TxtBuscar_KeyDown"/>

                                <Button Content="Buscar"
                                        Width="100"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderBrush="#4CAF50"
                                        Margin="10,0,0,0"
                                        Click="BtnBuscar_Click"/>
                            </StackPanel>

                            <!-- PESTAÑAS DE CATEGORÍAS -->
                            <TabControl x:Name="TabControlCategorias" 
                                        Background="White" 
                                        BorderBrush="#CCC"
                                        Margin="0,10,0,20"
                                        SelectionChanged="TabControl_SelectionChanged">

                                <!-- Cartón -->
                                <TabItem Header="Cartón">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="Productos de Cartón"
                                                   FontWeight="Bold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,15"
                                                   FontSize="16"/>

                                        <DataGrid x:Name="CartonDataGrid" 
                                                  AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" 
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  AlternatingRowBackground="#F9F9F9"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderBrush="#CCC"
                                                  BorderThickness="1">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="60"/>
                                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200"/>
                                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </TabItem>

                                <!-- Plásticos -->
                                <TabItem Header="Plásticos">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="Productos de Plásticos"
                                                   FontWeight="Bold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,15"
                                                   FontSize="16"/>

                                        <DataGrid x:Name="PlasticosDataGrid" 
                                                  AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" 
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  AlternatingRowBackground="#F9F9F9"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderBrush="#CCC"
                                                  BorderThickness="1">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="60"/>
                                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200"/>
                                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </TabItem>

                                <!-- Vehículos -->
                                <TabItem Header="Vehículos">
                                    <StackPanel Margin="15">
                                        <TextBlock Text="Productos de Vehículos"
                                                   FontWeight="Bold"
                                                   Foreground="#333"
                                                   Margin="0,0,0,15"
                                                   FontSize="16"/>

                                        <DataGrid x:Name="VehiculosDataGrid" 
                                                  AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" 
                                                  CanUserAddRows="False"
                                                  IsReadOnly="True"
                                                  AlternatingRowBackground="#F9F9F9"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderBrush="#CCC"
                                                  BorderThickness="1">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="ID" Binding="{Binding IdProducto}" Width="60"/>
                                                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="200"/>
                                                <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                                                <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>

                            <!-- BOTONES -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,10,0,0">

                                <Button Content="Actualizar Catálogo"
                                        Width="150"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderBrush="#4CAF50"
                                        Margin="5"
                                        Click="BtnActualizarCatalogo_Click"/>

                                <Button Content="Ir a Menú"
                                        Width="150"
                                        Background="#2196F3"
                                        Foreground="White"
                                        BorderBrush="#2196F3"
                                        Margin="5"
                                        Click="BtnIrMenu_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>